            "gap": "token:spacing_lg"
          },
          "slots": [
            {
              "layout": "hstack",
              "style": {
                "gap": "token:spacing"
              },
              "slots": [
                {
                  "icon": {
                    "from": "icon"
                  },
                  "style": {
