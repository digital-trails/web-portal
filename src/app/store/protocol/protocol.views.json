            },
            {
              "layout": "vstack",
              "style": {
                "gap": "token:spacing"
              },
              "items": {
                "from": "Reports",
                "item": {
                  "layout": "container",
                  "style": {
                    "background": "theme:Accent",
                    "radius": "token:radius_md",
                    "padding": "token:spacing"
                  },
                  "slots": [
                    {
                      "text": {
                        "from": "Title"
                      },
                      "style": {
                        "fontSize": "token:body_size",
                        "color": "theme:Text"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "ref": {
      "_fallback": true,
      "layout": "container",
      "slots": [
        {
          "text": {
            "literal": "Reference element"
          }
        }
      ]
    }
  },
  "flowElements": {
    "text": {
      "layout": "container",
      "style": {
